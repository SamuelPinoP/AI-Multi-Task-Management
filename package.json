{
  "name": "ai-multi-task-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run validate:deploy-env && prisma validate && prisma generate && node scripts/migrate-deployment-database.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx prisma/seed.ts",
    "validate:deploy-env": "node scripts/validate-deployment-env.mjs",
    "test:storage": "node --conditions react-server --import tsx --test src/lib/project-chat-*.test.ts",
    "verify:storage": "node --conditions react-server --import tsx scripts/verify-s3-storage.ts",
    "test:unit": "node --import tsx --test src/lib/event-time.test.ts src/lib/safe-redirect.test.ts src/lib/project-chat-quota.test.ts src/lib/project-chat-attachment-display.test.ts src/lib/http-range.test.ts src/lib/database-url.test.ts src/lib/email-config.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/run-playwright-e2e.mjs",
    "test:e2e:headed": "node scripts/run-playwright-e2e.mjs --headed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/blob": "^2.8.2",
    "dotenv": "^18.0.8",
    "mammoth": "^1.12.1",
    "next": "16.4.2",
    "nodemailer": "10.1.2",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "prisma": "^7.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
