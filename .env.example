# Copy this file to .env for local development and fill in your own values.
# Never commit .env, real database credentials, or storage secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
# Vercel Preview only: the separate preview database. Set by the Neon resource
# "ai-multi-task-preview" (connected to Preview with the PREVIEW_ prefix). When
# set, previews use it instead of DATABASE_URL and apply migrations to it.
# PREVIEW_DATABASE_URL=""

# Public account-creation controls. Defaults are enabled when omitted.
# If set, deployment validation requires exactly "true" or "false".
# Set these to "false" in production if you do not want anonymous database growth.
SIGNUP_ENABLED="true"
GUEST_LOGIN_ENABLED="true"

# Project Chat upload routing. Each value supports local, vercel-blob, or aws-s3.
PROJECT_CHAT_DEFAULT_STORAGE_PROVIDER="local"
PROJECT_CHAT_VIDEO_STORAGE_PROVIDER="local"
# Deprecated fallback for deployments not yet using the two routing variables.
# Explicit default/video variables take precedence over this value.
# PROJECT_CHAT_STORAGE_PROVIDER="local"
PROJECT_CHAT_PUBLIC_UPLOAD_PATH="/uploads/project-chat"

# For Vercel Blob production:
# PROJECT_CHAT_DEFAULT_STORAGE_PROVIDER="vercel-blob"
# PROJECT_CHAT_VIDEO_STORAGE_PROVIDER="aws-s3"
# BLOB_READ_WRITE_TOKEN is a server-side secret. Do not expose it with NEXT_PUBLIC_.
# BLOB_READ_WRITE_TOKEN="your-vercel-blob-read-write-token"
# PROJECT_CHAT_BLOB_PREFIX="project-chat"

# Private AWS S3 storage (server-side values only).
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET_NAME="your-private-bucket"
# PROJECT_CHAT_S3_PREFIX="project-chat"
# AWS_ACCESS_KEY_ID="" # Optional with an IAM role/default credential chain.
# AWS_SECRET_ACCESS_KEY="" # Set together with AWS_ACCESS_KEY_ID.
# AWS_S3_ENDPOINT="" # Optional for an S3-compatible endpoint.
# AWS_S3_FORCE_PATH_STYLE="false" # Usually needed only by custom endpoints.
# AWS_S3_PRESIGNED_URL_EXPIRATION_SECONDS="600"
# Also configure S3 bucket CORS for your app origin; see docs/aws-s3-storage.md.

# Storage cap for files stored with aws-s3 (for example Cloudflare R2, which has
# no spending cap). Uploads that would pass either limit are refused with HTTP 413.
# Whole numbers of bytes. Defaults: 8 GB for everyone together (under R2's 10 GB
# free tier) and 500 MB per user. "0" turns S3 uploads off.
# PROJECT_CHAT_S3_QUOTA_BYTES="8589934592"
# PROJECT_CHAT_USER_QUOTA_BYTES="524288000"
# Guest users can't upload files unless this is "true". Default: "false".
# PROJECT_CHAT_GUEST_UPLOADS_ENABLED="false"

# Optional project invitation email notifications. Disabled when omitted.
# EMAIL_PROVIDER may be "disabled", "resend", "smtp" (Gmail by default) or "brevo".
EMAIL_PROVIDER="disabled"
# Required when EMAIL_PROVIDER="smtp". Use a dedicated Gmail account with 2-Step
# Verification and an app password (never the account password). Server-side secrets.
# SMTP_USER="your-app@gmail.com"
# SMTP_PASS="your gmail app password"
# Optional; the defaults are Gmail's.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# Required when EMAIL_PROVIDER="brevo", together with EMAIL_FROM (a sender verified in Brevo).
# BREVO_API_KEY="xkeysib-your-brevo-key"
# Required only when EMAIL_PROVIDER="resend". Server-side secret; never expose with NEXT_PUBLIC_.
# RESEND_API_KEY="re_your_resend_api_key"
# Required only when EMAIL_PROVIDER="resend". Use a verified sender in Resend.
# EMAIL_FROM="AI Multi <noreply@example.com>"
# Optional: if set, /api/cron/backup (the daily database backup) requires it as a
# bearer token. Vercel Cron sends it automatically. At least 16 characters.
# CRON_SECRET=""
# Absolute links in invitation and password reset emails. Required on Vercel production.
# APP_BASE_URL="http://localhost:3000"
