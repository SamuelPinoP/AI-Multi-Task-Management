// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  notes       Note[]
  tasks       Task[]
  weeklyGoals WeeklyGoal[]
  events      Event[]
  projects    Project[]
  activities  Activity[]
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  userId    String
  projectId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?
  deletedAt   DateTime?
  recurrence Recurrence @default(NONE)

  userId      String
  projectId   String?
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model WeeklyGoal {
  id          String         @id @default(cuid())
  title       String
  description String?
  targetWeek  String
  status      GoalStatus     @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  location    String?
  startTime   DateTime
  endTime     DateTime?
  hasStartTime Boolean @default(false)
  hasEndTime   Boolean @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  recurrence Recurrence @default(NONE)

  userId      String
  projectId   String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes       Note[]
  tasks       Task[]
  events      Event[]
  activities  Activity[]
}


model Activity {
  id         String             @id @default(cuid())
  action     ActivityAction
  message    String
  entityType ActivityEntityType
  entityId   String?
  createdAt  DateTime           @default(now())

  userId     String
  projectId  String?
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

enum ActivityAction {
  CREATED_NOTE
  CREATED_TASK
  COMPLETED_TASK
  CREATED_EVENT
  CREATED_PROJECT
  DELETED_ITEM
  RESTORED_ITEM
}

enum ActivityEntityType {
  NOTE
  TASK
  EVENT
  PROJECT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}


enum Recurrence {
  NONE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}
