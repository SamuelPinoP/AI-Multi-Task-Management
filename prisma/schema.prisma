// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                     @id @default(cuid())
  email                     String                     @unique
  name                      String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  passwordHash              String?
  sessions                  Session[]
  notes                     Note[]
  tasks                     Task[]
  weeklyGoals               WeeklyGoal[]
  events                    Event[]
  projects                  Project[]
  activities                Activity[]
  projectMemberNotes        ProjectMemberNote[]        @relation("ProjectMemberNoteAuthor")
  projectComments           ProjectComment[]
  projectCommentAttachments ProjectCommentAttachment[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Note {
  id        String    @id @default(cuid())
  title     String
  content   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  userId    String
  projectId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?
  deletedAt   DateTime?
  recurrence  Recurrence @default(NONE)

  userId     String
  projectId  String?
  assigneeId String?
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee   ProjectMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
}

model WeeklyGoal {
  id          String     @id @default(cuid())
  title       String
  description String?
  targetWeek  String
  status      GoalStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id           String     @id @default(cuid())
  title        String
  description  String?
  location     String?
  startTime    DateTime
  endTime      DateTime?
  hasStartTime Boolean    @default(false)
  hasEndTime   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  recurrence   Recurrence @default(NONE)

  userId    String
  projectId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  color       String?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes      Note[]
  tasks      Task[]
  members    ProjectMember[]
  events     Event[]
  activities Activity[]
  comments   ProjectComment[]
}

model ProjectComment {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  message   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments ProjectCommentAttachment[]

  @@index([projectId, createdAt])
  @@index([userId])
}

model ProjectCommentAttachment {
  id           String   @id @default(cuid())
  commentId    String
  userId       String
  fileName     String
  originalName String
  fileType     String
  fileSize     Int
  url          String
  createdAt    DateTime @default(now())

  comment ProjectComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@index([userId])
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  name      String
  email     String?
  role      ProjectMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  project Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
  notes   ProjectMemberNote[]

  @@index([projectId])
}

model ProjectMemberNote {
  id              String                      @id @default(cuid())
  memberId        String
  message         String
  visibility      ProjectMemberNoteVisibility @default(TEAM)
  createdByUserId String
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  member        ProjectMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdByUser User          @relation("ProjectMemberNoteAuthor", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([createdByUserId])
}

enum ProjectMemberNoteVisibility {
  TEAM
  PRIVATE
}

model Activity {
  id         String             @id @default(cuid())
  action     ActivityAction
  message    String
  entityType ActivityEntityType
  entityId   String?
  createdAt  DateTime           @default(now())

  userId    String
  projectId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

enum ActivityAction {
  CREATED_NOTE
  CREATED_TASK
  COMPLETED_TASK
  CREATED_EVENT
  CREATED_PROJECT
  DELETED_ITEM
  RESTORED_ITEM
}

enum ActivityEntityType {
  NOTE
  TASK
  EVENT
  PROJECT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ProjectMemberRole {
  OWNER
  MEMBER
  VIEWER
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}
