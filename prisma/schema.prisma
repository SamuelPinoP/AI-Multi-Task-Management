// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           String                        @id @default(cuid())
  email                        String                        @unique
  /// Another way to log in besides `email` (#351). Always lowercase, so it's unique regardless of case; see src/lib/username.ts.
  /// Null for guests and for accounts made before usernames, until they choose one on the Account page.
  username                     String?                       @unique
  name                         String?
  isGuest                      Boolean                       @default(false)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  passwordHash                 String?
  /// When the user proved they own `email`, by a confirmation or password reset link (#130).
  emailVerifiedAt              DateTime?
  /// The secret in the user's calendar subscription link, /api/calendar/<token>.ics (SMART-09).
  /// Stored as is so the link can be copied again; "New link" replaces it.
  calendarFeedToken            String?                       @unique
  /// When the user last used the app, to within an hour: set when they sign in, then by the requests
  /// that already read their session (src/lib/auth.ts). Null until their first sign-in after it existed.
  lastActiveAt                 DateTime?
  /// When the user agreed to the AI assistant's data notice (#307, #308); null until they do. Nothing is sent to
  /// an AI provider for them before that, or once AI_NOTICE_UPDATED moves past it (src/lib/ai/notice.ts).
  aiNoticeAcceptedAt           DateTime?
  /// How the AI bar shows on the person's pages (#308): at the bottom, minimized to a button, or hidden (then
  /// it waits on the AI page). Null until they choose, which shows the bar. Saved per account, not per device.
  aiDock                       AiDockState?
  /// The person's IANA time zone, such as "Europe/Madrid" (#478): the browser's `tz` cookie, saved by the requests
  /// that read the session whenever it changes (src/lib/auth.ts). AI apps connected over MCP send no cookie, so their
  /// tools use this to know the person's "today", or UTC while it's null.
  timeZone                     String?
  sessions                     Session[]
  signInEvents                 SignInEvent[]
  oauthAccounts                OAuthAccount[]
  passwordResetTokens          PasswordResetToken[]
  emailVerificationTokens      EmailVerificationToken[]
  notifications                Notification[]
  pushSubscriptions            PushSubscription[]
  notes                        Note[]
  tasks                        Task[]
  weeklyGoals                  WeeklyGoal[]
  events                       Event[]
  projects                     Project[]
  projectMemberships           ProjectMember[]
  sentProjectInvitations       ProjectInvitation[]           @relation("ProjectInvitationInviter")
  receivedProjectInvitations   ProjectInvitation[]           @relation("ProjectInvitationInvitee")
  activities                   Activity[]
  projectComments              ProjectComment[]
  projectCommentAttachments    ProjectCommentAttachment[]
  projectChatAttachmentUploads ProjectChatAttachmentUpload[]
  treePages                    TreePage[]
  recentShortcut               RecentShortcut?
  projectChatReads             ProjectChatRead[]
  directChatsAsA               DirectChat[]                  @relation("DirectChatUserA")
  directChatsAsB               DirectChat[]                  @relation("DirectChatUserB")
  directMessages               DirectMessage[]
  directChatReads              DirectChatRead[]
  labels                       Label[]
  taskComments                 TaskComment[]
  taskEvents                   TaskEvent[]
  agentRuns                    AgentRun[]
  agentChats                   AgentChat[]
  agentProposals               AgentProposal[]
  mcpGrants                    McpGrant[]
  mcpToolCalls                 McpToolCall[]
}

/// One message to the AI assistant (#307): who asked, what answered and how it went. It feeds the daily caps
/// (`modelRequests`), debugging and the cost of an action. It never holds what was asked or answered, nor the
/// tools' arguments. The daily cleanup deletes rows after AGENT_RUN_DAYS (src/lib/daily-cleanup.ts).
model AgentRun {
  id                 String          @id @default(cuid())
  userId             String
  /// When the message arrived.
  createdAt          DateTime        @default(now())
  /// The provider and model that answered, such as "gemini" and "gemini-3.1-flash-lite"; null when the
  /// rule-based planner answered without asking a model.
  provider           String?
  model              String?
  outcome            AgentRunOutcome
  /// Requests sent to the model; the daily caps add these up.
  modelRequests      Int             @default(0)
  /// The tools the model called, in order, by name only.
  toolCalls          String[]        @default([])
  /// Tool calls whose arguments failed validation, so never ran.
  validationFailures Int             @default(0)
  inputTokens        Int             @default(0)
  outputTokens       Int             @default(0)
  /// From the message arriving to the last word of the answer.
  latencyMs          Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// A conversation with the AI assistant (#452), stored so the person can come back to it and so the server, not the
/// browser, decides which earlier messages the model sees. Each person keeps MAX_CHATS (src/lib/ai/chat-limits.ts):
/// saving another deletes the one whose latest message is oldest. The daily cleanup deletes chats nobody opened for
/// AGENT_CHAT_DAYS (src/lib/daily-cleanup.ts). Only exchanges whose answer arrived in full are stored.
model AgentChat {
  id        String             @id @default(cuid())
  userId    String
  /// The first question, shortened (chatTitle in src/lib/ai/chat-client.ts), until the person renames it.
  title     String
  createdAt DateTime           @default(now())
  /// When its latest message was stored: the list shows the newest first. Set by the code, not @updatedAt, so
  /// renaming or opening a chat doesn't move it up the list.
  updatedAt DateTime           @default(now())
  /// When the person last opened it or wrote in it. The daily cleanup counts its 90 days from here.
  openedAt  DateTime           @default(now())

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AgentChatMessage[]

  @@index([userId, updatedAt])
  @@index([openedAt])
}

/// One message of an AI assistant chat (#452): a question, or the answer the person saw, with the links it showed.
model AgentChatMessage {
  id        String        @id @default(cuid())
  chatId    String
  role      AgentChatRole
  content   String
  /// The items the answer linked to (`Source[]` in src/lib/ai/tools/define.ts): kind, id, title and link. [] for questions.
  sources   Json          @default("[]")
  createdAt DateTime      @default(now())

  chat     AgentChat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  /// The changes this answer proposed (#310), if any.
  proposal AgentProposal?

  @@index([chatId, createdAt])
}

/// Who wrote a stored AI chat message (#452).
enum AgentChatRole {
  /// The person's question.
  USER
  /// A model's answer.
  ASSISTANT
  /// The rule-based planner's answer, given when no model could answer (a cap, an outage, the person's country).
  PLANNER
}

/// Changes the AI assistant proposed in one answer (#310), which only the person can apply, all together in one
/// transaction, from the chat (src/lib/ai/proposals-server.ts). The model can't apply them. A pending proposal
/// can't be applied after `expiresAt`, an hour on. It goes with its chat; one whose answer wasn't stored goes in
/// the daily cleanup (src/lib/daily-cleanup.ts).
model AgentProposal {
  id        String              @id @default(cuid())
  userId    String
  /// The stored answer it belongs to; null until the answer is stored, or when it wasn't (the person left).
  messageId String?             @unique
  /// The changes, in order (`ProposalStep[]` in src/lib/ai/proposals.ts), with the titles the person saw.
  steps     Json
  status    AgentProposalStatus @default(PENDING)
  /// The steps applied, by index into `steps`; the person left out the rest. Empty until applied.
  applied   Int[]               @default([])
  /// Links to what applying changed, one per applied step (`ProposalLink[]`), for the stored chat.
  links     Json?
  createdAt DateTime            @default(now())
  expiresAt DateTime
  /// When it was applied, cancelled or refused.
  decidedAt DateTime?
  /// Why applying it was refused, as the person was told. Nothing changed.
  error     String?

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  message AgentChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Where an AI assistant proposal stands (#310). One past its `expiresAt` while still PENDING has expired.
enum AgentProposalStatus {
  /// Waiting for the person to apply or cancel it.
  PENDING
  /// Applied: every change was made, in one transaction.
  APPLIED
  /// Cancelled by the person: nothing changed.
  CANCELLED
  /// Applying it was refused (an item was gone, or access was lost), so nothing changed. `error` says why.
  FAILED
}

/// Where the AI bar is (#308): see User.aiDock.
enum AiDockState {
  /// At the bottom of every page.
  OPEN
  /// A ✦ button at the bottom right.
  MINIMIZED
  /// Off the pages; the AI page offers to show it again.
  HIDDEN
}

/// How an AI assistant message ended (src/lib/ai/chat.ts). Every outcome but ANSWERED, STEP_LIMIT,
/// INVALID_ARGUMENTS, CANCELLED and FAILED was answered by the rule-based planner instead.
enum AgentRunOutcome {
  /// The model answered.
  ANSWERED
  /// The model wanted more tool steps than one message allows.
  STEP_LIMIT
  /// The model's tool arguments failed validation twice.
  INVALID_ARGUMENTS
  /// The provider said too many requests (HTTP 429).
  RATE_LIMITED
  /// The provider failed or refused the request.
  PROVIDER_ERROR
  /// The answer took longer than the run's deadline.
  TIMED_OUT
  /// The person closed the connection before the answer finished.
  CANCELLED
  /// The person had used their daily allowance.
  USER_LIMIT
  /// The whole app had used its daily allowance.
  APP_LIMIT
  /// No model is configured on this server (no key, or an unknown provider).
  DISABLED
  /// Something went wrong in AI Multi itself.
  FAILED
  /// The person is where the provider's free tier may not be offered (src/lib/ai/region.ts).
  REGION
}

/// An AI app the person allowed to use their account over MCP (#478), and what it may do. Its access tokens name the
/// grant, and every tool call checks that it still stands (src/lib/mcp/tools.ts). The consent page (#477) creates
/// grants, and its Connected apps list revokes them.
model McpGrant {
  id         String    @id @default(cuid())
  userId     String
  /// The app's OAuth client ID: the address of its Client ID Metadata Document, or the ID registration gave it.
  clientId   String
  /// The app's name as the person approved it, such as "Claude".
  clientName String
  /// What the person allowed: "read", and later "write" (#479). A token never carries a scope its grant lacks.
  scopes     String[]
  createdAt  DateTime  @default(now())
  /// When the app last called a tool, to within an hour.
  lastUsedAt DateTime?
  /// When the person disconnected the app. From then on its tools refuse, even with a token that hasn't expired.
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One tool call from an AI app connected over MCP (#478): when, which app and tool, how it ended and how long it
/// took. Never the arguments or the answer. Kept 30 days (src/lib/daily-cleanup.ts).
model McpToolCall {
  id         String             @id @default(cuid())
  userId     String
  /// The app's OAuth client ID, from its access token.
  clientId   String
  tool       String
  outcome    McpToolCallOutcome
  durationMs Int
  createdAt  DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// How a tool call over MCP ended (src/lib/mcp/tools.ts).
enum McpToolCallOutcome {
  /// The tool answered.
  OK
  /// Nothing ran: the app was disconnected, or the account can't use connected apps.
  DENIED
  /// The tool failed, and the app was told so.
  FAILED
}

model Session {
  id        String   @id @default(cuid())
  /// SHA-256 of the session token (hex). The token itself is only in the browser cookie.
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// One sign-in: every new session records how it started (src/lib/sign-in-history-core.ts). Kept for
/// SIGN_IN_HISTORY_DAYS, then the daily cleanup deletes it. No IP addresses are stored.
model SignInEvent {
  id         String       @id @default(cuid())
  userId     String
  method     SignInMethod
  /// The session that made the account, right after signing up.
  newAccount Boolean      @default(false)
  /// The browser and system, such as "Chrome on Windows", read from the user agent; null when unknown.
  device     String?
  /// The two-letter country Vercel reports for the connection (x-vercel-ip-country); null when unknown.
  country    String?
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

enum SignInMethod {
  PASSWORD
  GOOGLE
  GUEST
}

/// An account at a sign-in provider that logs in as a user (#356), such as their Google account.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  /// "google".
  provider          String
  /// The provider's id for the person (Google's `sub`). It never changes, unlike their email.
  providerAccountId String
  /// The address the provider gave at the last sign-in. Sign-ins match on providerAccountId, never this.
  email             String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A link that confirms the user owns their email address (#130). Only the SHA-256 is stored.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// The in-app inbox behind the bell (SMART-08).
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  /// Where clicking it goes, an app path such as /tasks?task=<id>.
  url       String?
  /// Stops repeats, e.g. one "due today" reminder per task and due date.
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
}

enum NotificationType {
  TASK_ASSIGNED
  MENTION
  TASK_DUE_SOON
  /// Someone commented on a task assigned to you (#279).
  TASK_COMMENT
}

/// A browser that asked for push notifications (Web Push, SMART-08).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  /// The push service URL for this browser; unique across users.
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Note {
  id          String    @id @default(cuid())
  title       String
  content     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  /// Who moved it to the trash; they can restore it even if they don't own it (BUG-12).
  deletedById String?
  /// Added by the app, not typed by the person: a project template's items, or a guest's sample workspace. Guest limits don't count it (#458).
  isStarter   Boolean   @default(false)

  userId          String
  projectId       String?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  recentShortcuts RecentShortcut[]

  /// The event these notes are for, e.g. meeting notes; same project as the note (SMART-05).
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  /// Tasks made from this note (SMART-05).
  tasks   Task[]

  @@index([eventId])
  @@index([deletedById])
}

model Task {
  id          String      @id @default(cuid())
  title       String
  description String?
  /// The note this task was made from (SMART-05).
  noteId      String?
  note        Note?       @relation(fields: [noteId], references: [id], onDelete: SetNull)
  status      TaskStatus  @default(TODO)
  priority    Priority    @default(NONE)
  dueDate     DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  completedAt DateTime?
  deletedAt   DateTime?
  /// Who moved it to the trash; they can restore it even if they don't own it (BUG-12).
  deletedById String?
  /// Added by the app, not typed by the person: a project template's items, or a guest's sample workspace. Guest limits don't count it (#458).
  isStarter   Boolean     @default(false)
  recurrence  Recurrence  @default(NONE)
  /// The weekly goal this task moves forward (SMART-04).
  goalId      String?
  goal        WeeklyGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  userId     String
  projectId  String?
  assigneeId String?
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee   ProjectMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  // Subtasks (SMART-02): one level deep; a subtask shares its parent's project.
  parentId  String?
  parent    Task?            @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks  Task[]           @relation("TaskSubtasks")
  // Dependencies (SMART-02): tasks that must finish before this one, and tasks waiting on this one.
  blockedBy TaskDependency[] @relation("DependencyTask")
  blocking  TaskDependency[] @relation("DependencyBlocker")
  labels    TaskLabel[]
  comments  TaskComment[]
  events    TaskEvent[]

  @@index([parentId])
  @@index([deletedById])
}

/// A colored tag on tasks (#276). A personal label belongs to a user and goes
/// on their personal tasks; a project label belongs to a project and goes on
/// its tasks. Exactly one of userId and projectId is set (checked in
/// src/lib/labels-server.ts). Names are unique per owner, ignoring case.
model Label {
  id        String   @id @default(cuid())
  name      String
  /// A color from the label palette (LABEL_COLORS in src/lib/labels.ts).
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String?
  projectId String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([userId, name])
  @@unique([projectId, name])
}

/// A comment on a task (#279). Everyone who can see the task reads it;
/// Owners, Editors and the task's assignee write them, and authors edit or
/// delete their own.
model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// When the author last edited it; null if never.
  editedAt  DateTime?

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

/// One change to a task, for its history (#279). Values are kept as they
/// read at the time ("High", "Babel"), so later renames don't rewrite history.
model TaskEvent {
  id        String        @id @default(cuid())
  taskId    String
  /// Who made the change; null once their account is deleted.
  actorId   String?
  kind      TaskEventKind
  fromValue String?
  toValue   String?
  createdAt DateTime      @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

enum TaskEventKind {
  CREATED
  STATUS
  PRIORITY
  ASSIGNEE
  DUE_DATE
  PROJECT
  LABEL_ADDED
  LABEL_REMOVED
  TITLE
  DESCRIPTION
}

/// The labels on a task (#276). Deleting a label removes it from its tasks.
model TaskLabel {
  taskId    String
  labelId   String
  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

/// "taskId can't finish until blockedById is done" (SMART-02).
model TaskDependency {
  id          String   @id @default(cuid())
  taskId      String
  blockedById String
  createdAt   DateTime @default(now())

  task      Task @relation("DependencyTask", fields: [taskId], references: [id], onDelete: Cascade)
  blockedBy Task @relation("DependencyBlocker", fields: [blockedById], references: [id], onDelete: Cascade)

  @@unique([taskId, blockedById])
  @@index([blockedById])
}

model WeeklyGoal {
  id          String     @id @default(cuid())
  title       String
  description String?
  /// ISO week, e.g. "2026-W43" (src/lib/weekly-review.ts).
  targetWeek  String
  status      GoalStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  Task[]

  @@index([userId, targetWeek])
}

model Event {
  id           String     @id @default(cuid())
  title        String
  description  String?
  location     String?
  startTime    DateTime
  endTime      DateTime?
  hasStartTime Boolean    @default(false)
  hasEndTime   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  /// Who moved it to the trash; they can restore it even if they don't own it (BUG-12).
  deletedById  String?
  /// Added by the app, not typed by the person: a project template's items, or a guest's sample workspace. Guest limits don't count it (#458).
  isStarter    Boolean    @default(false)
  recurrence   Recurrence @default(NONE)
  /// The last day a repeat can start on (empty: keeps repeating). endTime is the first occurrence's end.
  repeatUntil  DateTime?  @db.Date
  /// Days deleted from a repeating series, so they don't happen (CAL-03), like iCalendar's EXDATE.
  skippedDates DateTime[] @default([]) @db.Date

  userId    String
  projectId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  notes     Note[]

  @@index([deletedById])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  color       String?
  status      ProjectStatus @default(ACTIVE)
  /// Orders the project's group on the Tasks page (#361).
  priority    Priority      @default(NONE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  /// Added by the app, not typed by the person: a project template's items, or a guest's sample workspace. Guest limits don't count it (#458).
  isStarter   Boolean       @default(false)
  /// "owner/name" of a public GitHub repository shown on the project (SMART-12).
  githubRepo  String?

  userId            String
  user              User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes             Note[]
  tasks             Task[]
  members           ProjectMember[]
  invitations       ProjectInvitation[]
  events            Event[]
  activities        Activity[]
  comments          ProjectComment[]
  attachmentUploads ProjectChatAttachmentUpload[]
  recentShortcuts   RecentShortcut[]
  chatReads         ProjectChatRead[]
  labels            Label[]
  photo             ProjectPhoto?
}

/// A project's photo (#403), shown in Chats. A table of its own, so project queries never load the image.
/// The browser crops it to a 256 px square first, so a row holds about 10 to 40 KB; src/lib/project-photo.ts has the limits.
model ProjectPhoto {
  projectId   String   @id
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// image/webp, image/jpeg or image/png, read from the bytes when it was uploaded.
  contentType String
  bytes       Bytes
  /// Goes into the photo's URL (?v=), so browsers keep each version for good and fetch a new one when it changes.
  updatedAt   DateTime @updatedAt
}

model ProjectComment {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  message   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments ProjectCommentAttachment[]

  @@index([projectId, createdAt])
  @@index([userId])
}

/// A one-to-one chat between two people (#387). They must share a project to
/// start one or to send in it; either can always read it. `userAId` is the
/// smaller of the two user ids, so a pair has one chat whoever wrote first.
model DirectChat {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA    User             @relation("DirectChatUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User             @relation("DirectChatUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages DirectMessage[]
  reads    DirectChatRead[]

  @@unique([userAId, userBId])
  @@index([userBId])
}

/// A message in a direct chat (#387). Text only; pinned and edited like a project chat message.
model DirectMessage {
  id        String   @id @default(cuid())
  chatId    String
  userId    String
  message   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chat DirectChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@index([userId])
}

/// When each person last read each direct chat, for unread counts (#387), like ProjectChatRead.
model DirectChatRead {
  userId     String
  chatId     String
  lastReadAt DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat DirectChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([userId, chatId])
  @@index([chatId])
}

/// When each user last read each project's chat, for unread counts (SIDE-03).
model ProjectChatRead {
  userId     String
  projectId  String
  lastReadAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

model ProjectCommentAttachment {
  id              String                     @id @default(cuid())
  commentId       String
  userId          String
  fileName        String
  originalName    String
  fileType        String
  fileSize        Int
  url             String
  storageProvider ProjectChatStorageProvider
  storageKey      String
  createdAt       DateTime                   @default(now())

  comment ProjectComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@index([userId])
}

model ProjectChatAttachmentUpload {
  id              String                     @id @default(cuid())
  projectId       String
  userId          String
  fileName        String
  originalName    String
  fileType        String
  fileSize        Int
  url             String
  storageProvider ProjectChatStorageProvider
  storageKey      String                     @unique
  expiresAt       DateTime
  createdAt       DateTime                   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, userId])
  @@index([expiresAt])
}

/// Request counters for rate limiting (src/lib/rate-limit.ts). The key is a
/// rule name plus a SHA-256 fingerprint of the caller (IP, email or user id),
/// so no addresses are stored in readable form.
model RateLimit {
  key           String   @id
  /// Fixed window number for the rule: floor(time in ms / window length).
  window        Int
  count         Int
  previousCount Int      @default(0)
  /// Set by the database; once past, the counter no longer matters.
  expiresAt     DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

/// How many emails the app sent, or failed to send, in each hour, for the free-tier usage page (#286):
/// Gmail allows about 500 a day. One row per hour that had email; the daily cleanup deletes old rows.
model EmailHourlyCount {
  /// The start of the hour, in UTC.
  hour   DateTime @id
  sent   Int      @default(0)
  failed Int      @default(0)
}

enum ProjectChatStorageProvider {
  LOCAL
  VERCEL_BLOB
  AWS_S3
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  userId    String?
  name      String
  email     String?
  role      ProjectMemberRole @default(EDITOR)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  tasks       Task[]

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectInvitation {
  id              String                  @id @default(cuid())
  projectId       String
  inviterUserId   String
  invitedEmail    String
  invitedUserId   String?
  /// Set when someone was invited by their username (#393): the inviter knows that, never their email.
  invitedUsername String?
  status          ProjectInvitationStatus @default(PENDING)
  role            ProjectMemberRole       @default(EDITOR)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviterUser User    @relation("ProjectInvitationInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  invitedUser User?   @relation("ProjectInvitationInvitee", fields: [invitedUserId], references: [id], onDelete: SetNull)

  // One pending invitation per email and project. Accepted and declined ones
  // stay as history, so a removed member can be invited again (#128).
  @@unique([projectId, invitedEmail], where: raw("status = 'PENDING'"))
  @@index([projectId])
  @@index([inviterUserId])
  @@index([invitedUserId])
  @@index([invitedEmail])
}

model TreePage {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes  TreeNode[]

  @@index([userId, updatedAt])
}

model TreeNode {
  id          String   @id @default(cuid())
  pageId      String
  parentId    String?
  title       String
  description String?
  color       String   @default("blue")
  width       Int      @default(240)
  height      Int      @default(160)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  page     TreePage   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parent   TreeNode?  @relation("TreeNodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children TreeNode[] @relation("TreeNodeChildren")

  @@index([pageId, parentId, sortOrder])
  @@index([parentId])
}

model Activity {
  id         String             @id @default(cuid())
  action     ActivityAction
  message    String
  entityType ActivityEntityType
  entityId   String?
  createdAt  DateTime           @default(now())

  userId    String
  projectId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

enum ActivityAction {
  CREATED_NOTE
  CREATED_TASK
  COMPLETED_TASK
  CREATED_EVENT
  CREATED_PROJECT
  /// A message in a project's chat.
  COMMENTED
  DELETED_ITEM
  RESTORED_ITEM
  /// A task's fields changed through the AI assistant (#310). Edits in the app itself go to the task's history only.
  UPDATED_TASK
}

enum ActivityEntityType {
  NOTE
  TASK
  EVENT
  PROJECT
}

model RecentShortcut {
  id              String    @id @default(cuid())
  userId          String    @unique
  projectId       String?
  noteId          String?
  projectOpenedAt DateTime?
  noteOpenedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  note    Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([noteId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

/// Task and project priorities, lowest first (#361). Postgres sorts enum
/// values in this order, so `orderBy: { priority: "desc" }` puts Urgent first
/// and No priority last.
enum Priority {
  /// No priority set: new tasks and projects start here.
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

/// Project roles (#385); the rules are in src/lib/project-roles.ts. The project's owner is Project.userId.
/// ADMIN also manages members. EDITOR is every other member: everyone edits.
enum ProjectMemberRole {
  OWNER
  EDITOR
  ADMIN
}

enum ProjectInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}
